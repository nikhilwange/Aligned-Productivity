# Server-side only — set in Vercel Project Settings → Environment Variables.
# Never use a VITE_ prefix for these; that would bundle them into the client.
GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Help & Support form email (api/support/submit.ts) — the GoDaddy mailbox's SMTP
# (getitaligned.com mail is on secureserver.net, not Titan), the same details
# Supabase Auth → SMTP Settings uses.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=support@getitaligned.com
SMTP_PASS=your_titan_mailbox_password_here

# Client-side (safe to expose) — used by the browser to talk to Supabase directly.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# WhatsApp Business number, digits with country code (e.g. 919876543210).
# Leave empty to hide every WhatsApp button.
VITE_SUPPORT_WHATSAPP=
